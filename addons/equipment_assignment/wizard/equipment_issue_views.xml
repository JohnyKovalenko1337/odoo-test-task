<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_issue_wizard_form" model="ir.ui.view">
        <field name="name">equipment.issue.wizard.form</field>
        <field name="model">equipment.issue.wizard</field>
        <field name="arch" type="xml">
            <form string="Видача обладнання">
                <group>
                    <field name="company_id" invisible="1"/>
                    <field name="equipment_id" readonly="1" force_save="1"/>
                    <field name="employee_id" domain="[('company_id', '=', company_id)]" options="{'no_create': True}"/>
                    <field name="issue_date"/>
                </group>
                <footer>
                    <button name="action_issue" type="object" string="Видано" class="btn-primary"/>
                    <button string="Скасувати" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
